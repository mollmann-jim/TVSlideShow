#!/bin/bash
set -x
WHERE=/home/jim/tools/TVSlideShow.py/Logs/BackGround
# keep only the newest
REMOVE=$(ls -t $WHERE.* | sed 1,20d)
if [ -n "$REMOVE" ]; then
    /bin/rm $REMOVE
fi
OUT=$WHERE.$(/bin/date +%F-%T | /bin/tr : .);
while true; do
    time /home/jim/tools/TVSlideShow/BackGround.py 2>&1 > $OUT;
    sleep 47
    done
